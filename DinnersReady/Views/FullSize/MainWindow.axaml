<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mobileviews="using:DinnersReady.Views.Mobile"
        xmlns:sharedviews="using:DinnersReady.Views"
        xmlns:vm="using:DinnersReady.ViewModels"
        xmlns:webviews="using:DinnersReady.Views.Web"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DinnersReady.Views.FullSize.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/DinnersReady.ico"
        Title="DinnersReady">
    <!-- DESIGN-TIME DATA CONTEXT -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <webviews:MainView />
</Window>
