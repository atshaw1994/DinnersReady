<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:DinnersReady.ViewModels"
             xmlns:models="using:DinnersReady.Models"
             xmlns:designData="using:DinnersReady.DesignData"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="DinnersReady.Views.FullSize.SavedRecipeControl"
             x:DataType="models:GeneratedRecipe">
    <!-- DESIGN-TIME RECIPE MOCK -->
    <Design.DataContext>
        <x:Static Member="designData:GeneratedRecipe_DesignData.CheesyOmelette" />
    </Design.DataContext>

    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="12" >
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- Edit & Delete Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).ShareRecipeCommand}"
                        CommandParameter="{Binding}"
                        Padding="8" Width="36" Height="36" CornerRadius="18">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </Button.Styles>
                    <ic:FluentIcon Icon="ShareIos"/>
                </Button>
                <Button Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).DeleteRecipeCommand}"
                        CommandParameter="{Binding}"
                        Padding="8" Width="36" Height="36" CornerRadius="18">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Red" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </Button.Styles>
                    <ic:FluentIcon Icon="Delete"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>