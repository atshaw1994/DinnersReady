<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sharedviews="using:DinnersReady.Views"
             xmlns:vm="using:DinnersReady.ViewModels"
             xmlns:fsviews="using:DinnersReady.Views.FullSize"
             xmlns:mobileviews="using:DinnersReady.Views.Mobile"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DinnersReady.Views.Web.MainView"
             x:DataType="vm:MainViewModel">
    <!-- DESIGN-TIME DATA CONTEXT -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <TabbedPage>
            <TabbedPage.Styles>
                <StyleInclude Source="/Assets/TabbedPageStyles.axaml" />
            </TabbedPage.Styles>

            <!-- HOME TAB -->
            <ContentPage>
                <ContentPage.Header>
                    <TextBlock Classes="headerText" Text="Home"/>
                </ContentPage.Header>

                <!-- Use RowDefinitions so the AiRecipeGenerator gets constrained height -->
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Text="Welcome to DinnersReady!" FontSize="24" FontWeight="Bold" Margin="16,16,16,0"/>
                    <TextBlock Grid.Row="1" Text="Add ingredients and then click Generate!" Margin="16,8"/>
                   
                    <!-- The view that displays progress and results -->
                    <sharedviews:AiRecipeGenerator Grid.Row="2" Margin="8,0" DataContext="{Binding RecipeGenerator}"/>
                </Grid>
            </ContentPage>

            <!-- PANTRY TAB -->
            <ContentPage>
                <ContentPage.Header>
                    <TextBlock Classes="headerText" Text="Pantry"/>
                </ContentPage.Header>

                <fsviews:PantryPage />
            </ContentPage>

            <!-- FRIDGE TAB -->
            <ContentPage>
                <ContentPage.Header>
                    <TextBlock Classes="headerText" Text="Fridge"/>
                </ContentPage.Header>
            
                <fsviews:FridgePage />
            </ContentPage>

            <!-- SAVED RECIPES TAB -->
            <ContentPage>
                <ContentPage.Header>
                    <TextBlock Classes="headerText" Text="Recipes"/>
                </ContentPage.Header>
            
                <fsviews:SavedRecipesPage />
            </ContentPage>
        </TabbedPage>

        <!-- OVERLAY ADD FORM -->
        <mobileviews:AddIngredientOverlayView />
    </Grid>
</UserControl>
