<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mobileviews="using:DinnersReady.Views.Mobile"
             xmlns:vm="using:DinnersReady.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="600"
             x:Class="DinnersReady.Views.Mobile.PantryPage"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="No pantry items added yet." 
                       IsVisible="{Binding !PantryItems.Count}" 
                       Opacity="0.6" 
                       HorizontalAlignment="Center" 
                       Margin="0,32,0,0"/>

            <ItemsControl ItemsSource="{Binding PantryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IngredientViewModel">
                        <mobileviews:IngredientControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>