<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:DinnersReady.ViewModels"
             xmlns:models="using:DinnersReady.Models"
             mc:Ignorable="d" d:DesignWidth="360"
             x:Class="DinnersReady.Views.Mobile.IngredientControl"
             x:DataType="models:Ingredient">
    <!-- DESIGN-TIME INGREDIENT MOCK -->
    <Design.DataContext>
        <models:Ingredient Id="cumin-ground"
                           Name="Ground Cumin"
                           Category="Spices"
                           Quantity="50"
                           Unit="g" />
    </Design.DataContext>
    
    <Grid ClipToBounds="True">
        <!-- Delete Button (Revealed Behind) -->
        <Button Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).DeleteIngredientCommand}"
                CommandParameter="{Binding}"
                Classes.open="{Binding IsSlidRight}"
                Background="Red"
                VerticalAlignment="Stretch"
                Padding="8" Width="64" CornerRadius="0">
            <Button.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Button.Transitions>
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="RenderTransform" Value="translateX(-64px)" />
                </Style>
                <Style Selector="Button.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
            </Button.Styles>
            <ic:FluentIcon Icon="Delete" Foreground="White"/>
        </Button>

        <!-- Edit Button (Revealed Behind) -->
        <Button Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).DeleteIngredientCommand}"
                CommandParameter="{Binding}"
                Classes.open="{Binding IsSlidLeft}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Padding="8" Width="64" CornerRadius="0">
            <Button.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Button.Transitions>
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="RenderTransform" Value="translateX(64px)" />
                </Style>
                <Style Selector="Button.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
            </Button.Styles>
            <ic:FluentIcon Icon="Edit" Foreground="White"/>
        </Button>

        <!-- Sliding Main Content -->
        <Border x:Name="MainBorder"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Classes.left="{Binding IsSlidLeft}"
                Classes.right="{Binding IsSlidRight}"
                Padding="12">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <Border.Styles>
                <Style Selector="Border#MainBorder">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
                <Style Selector="Border#MainBorder.left">
                    <Setter Property="RenderTransform" Value="translateX(-64px)" />
                </Style>
                <Style Selector="Border#MainBorder.right">
                    <Setter Property="RenderTransform" Value="translateX(64px)" />
                </Style>
            </Border.Styles>

            <Border.GestureRecognizers>
                <SwipeGestureRecognizer CanHorizontallySwipe="True" IsMouseEnabled="True" Threshold="10" />
            </Border.GestureRecognizers>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Category}" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="•" Opacity="0.5" FontSize="12"/>
                    <TextBlock FontSize="12" Opacity="0.7">
                        <Run Text="{Binding Quantity}"/>
                        <Run Text="{Binding UnitDisplay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>