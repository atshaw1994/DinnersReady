<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:DinnersReady.ViewModels"
             xmlns:designData="using:DinnersReady.DesignData"
             mc:Ignorable="d" d:DesignWidth="360"
             x:Class="DinnersReady.Views.Mobile.SavedRecipeControl"
             x:DataType="vm:RecipeViewModel">
    <Design.DataContext>
        <vm:RecipeViewModel Model="{x:Static designData:Recipes.CheesyOmelette}"/>
    </Design.DataContext>
    
    <Grid ClipToBounds="True">
        <!-- Share Button (Revealed Behind) -->
        <Button Command="{Binding RequestShareCommand}"
                Classes.open="{Binding IsSlidLeft}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Padding="8" Width="64" CornerRadius="0">
            <Button.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Button.Transitions>
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="RenderTransform" Value="translateX(64px)" />
                </Style>
                <Style Selector="Button.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
            </Button.Styles>
            <ic:FluentIcon Icon="ShareIos" Foreground="White"/>
        </Button>
        
        <!-- Delete Button (Revealed Behind) -->
        <Button Command="{Binding RequestDeleteCommand}"
                Classes.open="{Binding IsSlidRight}"
                Background="Red"
                VerticalAlignment="Stretch"
                Padding="8" Width="64" CornerRadius="0">
            <Button.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Button.Transitions>
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="RenderTransform" Value="translateX(-64px)" />
                </Style>
                <Style Selector="Button.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
            </Button.Styles>
            <ic:FluentIcon Icon="Delete" Foreground="White"/>
        </Button>

        <!-- Sliding Main Content -->
        <Border x:Name="MainBorder"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Classes.left="{Binding IsSlidLeft}"
                Classes.right="{Binding IsSlidRight}"
                Padding="12">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" 
                                                   Duration="0:0:0.25" 
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <Border.Styles>
                <Style Selector="Border#MainBorder">
                    <Setter Property="RenderTransform" Value="translateX(0px)" />
                </Style>
                <Style Selector="Border#MainBorder.left">
                    <Setter Property="RenderTransform" Value="translateX(-64px)" />
                </Style>
                <Style Selector="Border#MainBorder.right">
                    <Setter Property="RenderTransform" Value="translateX(64px)" />
                </Style>
            </Border.Styles>

            <Border.GestureRecognizers>
                <SwipeGestureRecognizer CanHorizontallySwipe="True" IsMouseEnabled="True" Threshold="10" />
            </Border.GestureRecognizers>

            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>